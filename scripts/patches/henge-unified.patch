+name: HengeBackend
+options:
+  deploymentTarget:
+    iOS: "17.0"
+  createIntermediateGroups: true
+settings:
+  base:
+    ARCHS: arm64
+    ONLY_ACTIVE_ARCH: YES
+    ENABLE_BITCODE: NO
+    SWIFT_VERSION: "5.0"
+    SWIFT_OPTIMIZATION_LEVEL: "-O"
+    GCC_OPTIMIZATION_LEVEL: "2"
+    CLANG_C_LANGUAGE_STANDARD: c11
+    CODE_SIGNING_ALLOWED: NO
+    BUILD_LIBRARY_FOR_DISTRIBUTION: YES
+    SKIP_INSTALL: NO
+    DEFINES_MODULE: YES
+    CLANG_ENABLE_MODULES: YES
+    GENERATE_INFOPLIST_FILE: YES
+    SWIFT_ACTIVE_COMPILATION_CONDITIONS: "$(inherited) HENGE_EMBEDDED"
+    EXPORTED_SYMBOLS_FILE: "$(SRCROOT)/Embedded/exports.txt"
+    HEADER_SEARCH_PATHS:
+      - "$(SRCROOT)/../core"
+      - "$(SRCROOT)/../host"
+      - "$(SRCROOT)/../devices"
+    LIBRARY_SEARCH_PATHS:
+      - "$(inherited)"
+      - "$(SRCROOT)/../build/ios"
+      - "$(SRCROOT)/deps/lib"
+    LD_RUNPATH_SEARCH_PATHS:
+      - "$(inherited)"
+      - "@executable_path/Frameworks"
+      - "@loader_path/Frameworks"
+targets:
+  HengeBackend:
+    type: framework
+    platform: iOS
