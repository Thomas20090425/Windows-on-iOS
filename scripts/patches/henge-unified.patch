index 9a5c260..8b3f4f1 100644
--- a/ios/Henge/PhysicalMouseButtons.swift
+++ b/ios/Henge/PhysicalMouseButtons.swift
@@ -27,3 +27,43 @@ struct PhysicalMouseButtons {
         return releases
     }
 }
+
+/// Fractional input is retained per physical device, rather than amplified into wheel ticks.
+struct PhysicalMouseMotion {
+    private var x: Float = 0, y: Float = 0
+    private var horizontal: Float = 0, vertical: Float = 0
+
+    mutating func move(dx: Float, dy: Float, speed: Float) -> [(Int32, Int32)] {
+        guard dx.isFinite, dy.isFinite, speed.isFinite,
+              abs(dx) <= 4096, abs(dy) <= 4096 else { return [] }
+        let scale = min(max(speed, 0.1), 4)
+        x += dx * scale
+        y -= dy * scale
+        var wholeX = Int32(x.rounded()), wholeY = Int32(y.rounded())
+        x -= Float(wholeX)
+        y -= Float(wholeY)
+        var packets: [(Int32, Int32)] = []
+        // The guest mouse path uses signed-byte deltas. Preserve the distance
+        // while preventing a large gesture from wrapping to the opposite side.
+        while wholeX != 0 || wholeY != 0 {
+            let px = min(max(wholeX, -127), 127), py = min(max(wholeY, -127), 127)
+            packets.append((px, py))
+            wholeX -= px
+            wholeY -= py
+        }
+        return packets
+    }
+
+    mutating func scroll(_ value: Float, horizontal axis: Bool, trackpad: Bool, scale: Float) -> Int32 {
+        guard value.isFinite, scale.isFinite else { return 0 }
+        let sensitivity = min(max(scale, 0.1), 1.5) / 0.3
+        // Magic Keyboard reports small point deltas at display frequency;
+        // conventional wheel mice report detents. They are different units.
+        let delta = min(max(value * sensitivity / (trackpad ? 24 : 1), -4), 4)
+        var remainder = (axis ? horizontal : vertical) + delta
+        let whole = Int32(remainder.rounded(.towardZero))
+        remainder -= Float(whole)
+        if axis { horizontal = remainder } else { vertical = remainder }
+        return whole
+    }
+}
