+import AVFAudio
+import Foundation
+import SwiftUI
+import UIKit
+
+/// A VM-specific Henge session inside UTM. Native symbols stay in this dynamic framework.
+@MainActor
+@objc(UTMHengeBackend)
+public final class UTMHengeBackend: NSObject {
+    private static var initialized = false
+    private static var warming: Task<Void, Never>?
+    private static weak var active: EmbeddedMacModel?
+
+    /// Claim executable memory at launch while the Mac debugger can still answer Henge's exact BRKs.
+    /// This prepares the translator only; it never opens a guest disk or starts a VM.
+    @objc public static func prepareJIT() {
+        if !initialized {
+            initialized = true
+            HengeLog.start()
+            EngineTuning.apply()
+            JITBootstrap.noteLaunchState()
+            JITBootstrap.installTrapGuard()
+            try? AVAudioSession.sharedInstance().setCategory(.playback, options: [.mixWithOthers])
+            HengeLog.log("utm", "embedded macOS engine prepared; no guest started")
+        }
+        guard warming == nil, !JITBootstrap.ready else { return }
+        warming = Task { @MainActor in
+            defer { warming = nil }
+            // A launch-stopped process may not yet be marked debugged when the view first appears.
+            for _ in 0..<600 {
+                if Task.isCancelled || JITBootstrap.ready { return }
+                if JITBootstrap.debuggedFlag || JITBootstrap.canGrantOwnJIT {
+                    if JITBootstrap.prewarm() { return }
+                }
+                try? await Task.sleep(nanoseconds: 200_000_000)
+            }
+            HengeLog.log("utm", "still waiting for a debugger that can provide the JIT region")
+        }
+    }
+
+    @objc public static func makeViewController(packageURL: URL, configuration: NSDictionary,
+                                                stateChanged: @escaping (String, String?) -> Void) -> UIViewController {
+        prepareJIT()
+        let model = EmbeddedMacModel(package: packageURL, configuration: configuration, callback: stateChanged)
+        active = model
+        return UIHostingController(rootView: EmbeddedMacView(model: model))
+    }
+
+    @objc public static func requestStop(force: Bool) {
+        let state = henge_vm_state()
+        if state == 0 || state == 2 {
+            if Installer.shared.busy, Installer.shared.cancelBeforeRestore() { return }
+            active?.closed = true
+            active?.waitForStop()
+            return
+        }
+        if state == 3 { active?.waitForStop(); return }
+        guard state == 1 || state == 4 else { return }
+        if force {
+            henge_vm_stop()
+            active?.waitForStop()
+        } else {
+            // macOS owns the shutdown: a power key asks it to show its normal shutdown dialog.
+            henge_vm_key(116, 1)
+            henge_vm_key(116, 0)
+        }
+    }
+}
+
+@MainActor
+private final class EmbeddedMacModel: ObservableObject {
+    let configuration: NSDictionary
+    let folder: URL
+    let callback: (String, String?) -> Void
+    @Published var mac: VirtualMac?
+    @Published var error: String?
+    @Published var jitReady = false
+    @Published var releaseID = MacOSRelease.recommended.id
+    @Published var closed = false
+    private var nativeHasRun = false
+    private var lastEvent: String?
+    private var nativeWatcher: Task<Void, Never>?
+
+    init(package: URL, configuration: NSDictionary, callback: @escaping (String, String?) -> Void) {
+        self.configuration = configuration
+        self.callback = callback
+        self.folder = package.appendingPathComponent("Data/Henge", isDirectory: true)
+        loadExisting()
+        nativeWatcher = Task { @MainActor [weak self] in
+            while !Task.isCancelled {
+                guard self != nil else { return }
+                if self?.nativeHasRun == true, henge_vm_state() == 2 {
+                    self?.closed = true
+                    let failure = henge_vm_exit_outcome() == Int32(HENGE_VM_OUTCOME_ERROR.rawValue)
+                    self?.changed(failure ? "error" : "stopped", String(cString: henge_vm_exit_reason()))
+                    return
+                }
+                try? await Task.sleep(nanoseconds: 250_000_000)
+            }
+        }
+    }
+
+    deinit { nativeWatcher?.cancel() }
+
+    var name: String { configuration["name"] as? String ?? "Mac" }
+    func number(_ key: String, _ fallback: Int) -> Int { (configuration[key] as? NSNumber)?.intValue ?? fallback }
+    var localIPSW: URL? {
+        guard let path = configuration["installationMediaPath"] as? String, !path.isEmpty else { return nil }
+        return URL(fileURLWithPath: path)
+    }
+
+    func changed(_ state: String, _ message: String?) {
+        if state == "started" { nativeHasRun = true }
+        if state == "stopped" { closed = true }
+        guard state != lastEvent else { return }
+        lastEvent = state
+        callback(state, message)
+    }
+
+    func waitForStop(message: String? = nil, failure: Bool = false) {
+        Task { @MainActor in
+            // henge_vm_stop requests a stop; state 2 means the CPU threads and VM are actually released.
+            while henge_vm_state() == 3 { try? await Task.sleep(nanoseconds: 100_000_000) }
+            if henge_vm_state() == 2 || henge_vm_state() == 0 { changed(failure ? "error" : "stopped", message) }
+        }
+    }
+
+    func failedInstallation(_ text: String) {
+        if henge_vm_state() == 1 || henge_vm_state() == 4 { henge_vm_stop() }
+        waitForStop(message: text, failure: true)
+    }
+
+    func loadExisting() {
+        let fm = FileManager.default
+        let metadata = folder.appendingPathComponent("machine.json")
+        guard fm.fileExists(atPath: metadata.path) else {
+            if fm.fileExists(atPath: folder.appendingPathComponent("disk.img").path) {
+                error = "This Mac is missing machine.json. Its existing disk has been preserved."
+            }
+            return
+        }
+        do {
+            let object = try JSONSerialization.jsonObject(with: Data(contentsOf: metadata))
+            guard let info = object as? [String: Any], let ecid = (info["ecid"] as? NSNumber)?.uint64Value else {
+                throw embeddedMessage("This Mac's identity cannot be read. Its files have been preserved.")
+            }
+            for file in ["disk.img", "auxiliary.bin", "AVPBooter.vmapple2.bin"] {
+                guard fm.fileExists(atPath: folder.appendingPathComponent(file).path) else {
+                    throw embeddedMessage("This Mac is missing \(file). Its existing files have been preserved.")
+                }
+            }
+            var guest = VirtualMac(id: UUID(uuidString: configuration["uuid"] as? String ?? "") ?? UUID(),
+                                   name: name, ecid: ecid, seed: (info["seed"] as? NSNumber)?.uint64Value ?? 0,
+                                   ramMB: min(max(number("memoryMiB", (info["ramMB"] as? NSNumber)?.intValue ?? 4096), 1024), 262144),
+                                   diskBytes: Int64(min(max(number("diskSizeGiB", 64), 32), 2048)) << 30)
+            guest.storagePath = folder.path
+            guest.osName = try? String(contentsOf: folder.appendingPathComponent("installed"), encoding: .utf8)
+            guest.screenWidth = min(max(number("displayWidth", 1920), 640), 7680)
+            guest.screenHeight = min(max(number("displayHeight", 1080), 480), 4320)
+            guest.retina = false
+            mac = guest
+        } catch { self.error = error.localizedDescription }
+    }
+
+    func configure() {
+        UserDefaults.standard.set(min(max(number("cpuCount", 4), 1), 8), forKey: "henge.cpus")
+        if (configuration["networkEnabled"] as? NSNumber)?.boolValue == false { setenv("HENGE_NO_NET", "1", 1) }
+        else { unsetenv("HENGE_NO_NET") }
+        if (configuration["audioEnabled"] as? NSNumber)?.boolValue == false { setenv("HENGE_NO_SOUND", "1", 1) }
+        else { unsetenv("HENGE_NO_SOUND") }
+    }
+
+    func install() {
+        guard let release = MacOSRelease.all.first(where: { $0.id == releaseID }), JITBootstrap.ready else { return }
+        configure()
+        do { try FileManager.default.createDirectory(at: folder.deletingLastPathComponent(), withIntermediateDirectories: true) }
+        catch { self.error = error.localizedDescription; return }
+        changed("starting", "Installing macOS")
+        Installer.shared.start(release, name: name, ramMB: min(max(number("memoryMiB", 4096), 1024), 262144),
+                               cpus: min(max(number("cpuCount", 4), 1), 8), keepImage: true,
+                               targetDirectory: folder, localIPSW: localIPSW, diskSizeGiB: number("diskSizeGiB", 64))
+    }
+}
+
+@MainActor
+private struct EmbeddedMacView: View {
+    @ObservedObject var model: EmbeddedMacModel
+    @ObservedObject private var installer = Installer.shared
+
+    var body: some View {
+        Group {
+            if let error = model.error {
+                VStack(spacing: 16) {
+                    Image(systemName: "exclamationmark.triangle").font(.largeTitle)
+                    Text(model.name).font(.title2)
+                    Text(error).multilineTextAlignment(.center)
+                }.padding()
+            } else if let mac = model.mac, model.jitReady, !model.closed {
+                SessionView(mac: mac, engineStateChanged: model.changed) {
+                    model.closed = true
+                    model.waitForStop()
+                }.environment(\.colorScheme, .dark)
+            } else {
+                installOrWait.padding()
+            }
+        }
+        .task {
+            model.configure()
+            UTMHengeBackend.prepareJIT()
+            if let error = model.error { model.changed("error", error); return }
+            while !Task.isCancelled {
+                model.jitReady = JITBootstrap.ready
+                if model.jitReady { return }
+                try? await Task.sleep(nanoseconds: 200_000_000)
+            }
+        }
+        .onChange(of: installer.phase) { phase in
+            if case .failed(let text) = phase { model.failedInstallation(text) }
+            if case .done(let text) = phase { model.waitForStop(message: text) }
+        }
+    }
+
+    @ViewBuilder private var installOrWait: some View {
+        VStack(spacing: 20) {
+            Image(systemName: "desktopcomputer").font(.system(size: 44))
+            Text(model.name).font(.title2)
+            if model.closed {
+                Text("This Mac has stopped. Close and reopen UTM ARM Lab before starting it again.")
+            } else if !model.jitReady {
+                ProgressView()
+                Text("Waiting for Mac JIT").font(.headline)
+                Text("Connect this iPad to the Mac and run the unified app's JIT launcher. This Mac starts here when JIT is ready.")
+                    .multilineTextAlignment(.center).foregroundStyle(.secondary)
+            } else {
+                switch installer.phase {
+                case .done(let text), .failed(let text):
+                    Text(text).multilineTextAlignment(.center)
+                case .idle:
+                    Text("Install macOS on this Mac's new disk.")
+                    if let image = model.localIPSW {
+                        Label(image.lastPathComponent, systemImage: "externaldrive")
+                    } else {
+                        Picker("macOS", selection: $model.releaseID) {
+                            ForEach(MacOSRelease.all) { Text($0.name).tag($0.id) }
+                        }.pickerStyle(.menu)
+                    }
+                    Button("Install macOS") { model.install() }.buttonStyle(.borderedProminent)
+                case .checking, .preparing:
+                    ProgressView("Preparing this Mac…")
+                case .downloading:
+                    ProgressView(value: Double(installer.received), total: max(Double(installer.expected), 1))
+                    Text("Downloading macOS: \(ByteText.string(UInt64(max(installer.received, 0))))")
+                case .installing:
+                    ProgressView(value: installer.stepProgress)
+                    Text(Installer.stepName(installer.step))
+                    Text("Keep this app open until the installation finishes.").foregroundStyle(.secondary)
+                }
+            }
+        }.frame(maxWidth: 540)
+    }
+}
+
+private func embeddedMessage(_ text: String) -> NSError {
+    NSError(domain: "HengeBackend", code: 1, userInfo: [NSLocalizedDescriptionKey: text])
+}
