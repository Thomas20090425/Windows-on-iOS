@@ -0,0 +1,247 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#if os(iOS)
+import Foundation
+import SwiftUI
+import UIKit
+#if canImport(WindowsBackend)
+import WindowsBackend
+#endif
+#if canImport(HengeBackend)
+import HengeBackend
+#endif
+
+@MainActor enum UTMUnifiedEngineLease {
+    private(set) static var engine: String?
+    private(set) static var nativeID: UUID?
+    private static var prepared = false
+
+    static func claimQEMU() throws {
+        guard engine == nil || engine == "QEMU" else {
+            throw UTMNativeError.message("This launch has initialized an ARM64 engine. Close and reopen the app before starting a QEMU machine.")
+        }
+        engine = "QEMU"
+    }
+
+    static func claimNative(_ config: UTMNativeConfiguration) throws {
+        guard engine == nil || engine == config.engine.rawValue,
+              nativeID == nil || nativeID == config.information.uuid else {
+            throw UTMNativeError.message("Close and reopen the app before starting another machine or changing execution engines.")
+        }
+        engine = config.engine.rawValue
+        nativeID = config.information.uuid
+    }
+
+    static func prepareRequestedJIT() {
+        guard !prepared else { return }
+        prepared = true
+        guard let raw = ProcessInfo.processInfo.environment["UTM_NATIVE_ENGINE"],
+              let requested = UTMNativeEngine(rawValue: raw) else { return }
+        engine = requested.rawValue
+        switch requested {
+        case .windows:
+            #if canImport(WindowsBackend)
+            UTMWindowsBackend.prepareJIT()
+            #endif
+        case .macOS:
+            #if canImport(HengeBackend)
+            UTMHengeBackend.prepareJIT()
+            #endif
+        }
+    }
+}
+
+final class UTMNativeVirtualMachine: UTMVirtualMachine {
+    struct Capabilities: UTMVirtualMachineCapabilities {
+        var supportsProcessKill: Bool { false }
+        var supportsSnapshots: Bool { false }
+        var supportsScreenshots: Bool { false }
+        var supportsDisposibleMode: Bool { false }
+        var supportsRecoveryMode: Bool { false }
+        var supportsRemoteSession: Bool { false }
+    }
+    static let capabilities = Capabilities()
+
+    private(set) var pathUrl: URL
+    let isShortcut: Bool
+    var isRunningAsDisposible: Bool { false }
+    weak var delegate: (any UTMVirtualMachineDelegate)?
+    var onConfigurationChange: (() -> Void)?
+    var onStateChange: (() -> Void)?
+    private(set) var config: UTMNativeConfiguration { didSet { onConfigurationChange?() } }
+    private(set) var registryEntry: UTMRegistryEntry { didSet { onConfigurationChange?() } }
+    private(set) var state: UTMVirtualMachineState = .stopped {
+        didSet {
+            onStateChange?()
+            delegate?.virtualMachine(self, didTransitionToState: state)
+        }
+    }
+    var screenshot: UTMVirtualMachineScreenshot? { didSet { onStateChange?() } }
+    var snapshotUnsupportedError: Error? { UTMNativeError.message("This ARM64 engine does not support saved-state snapshots or suspension.") }
+    var isHeadless: Bool { false }
+    private var isScopedAccess: Bool
+    private var hasStarted = false
+    private var sessionPresentation: UIViewController?
+    private let sessionStatus = UTMNativeSessionStatus()
+    var isConfigurationEditable: Bool { state == .stopped && sessionPresentation == nil }
+
+    @MainActor required init(packageUrl: URL, configuration: UTMNativeConfiguration, isShortcut: Bool) throws {
+        try configuration.validate()
+        self.pathUrl = packageUrl
+        self.config = configuration
+        self.isShortcut = isShortcut
+        self.isScopedAccess = packageUrl.startAccessingSecurityScopedResource()
+        self.registryEntry = UTMRegistryEntry.empty
+        self.registryEntry = loadRegistry()
+        self.screenshot = loadScreenshot()
+    }
+
+    deinit { if isScopedAccess { pathUrl.stopAccessingSecurityScopedResource() } }
+
+    @MainActor func reload(from packageUrl: URL?) throws {
+        guard state == .stopped, sessionPresentation == nil else {
+            throw UTMNativeError.message("Close and reopen the app before reloading a machine whose engine has been initialized.")
+        }
+        let url = packageUrl ?? pathUrl
+        guard let configuration = try UTMNativeConfiguration.load(from: url) as? UTMNativeConfiguration else {
+            throw UTMConfigurationError.invalidBackend
+        }
+        if isScopedAccess { pathUrl.stopAccessingSecurityScopedResource() }
+        pathUrl = url
+        isScopedAccess = url.startAccessingSecurityScopedResource()
+        config = configuration
+    }
+
+    @MainActor func changeUuid(to uuid: UUID, name: String?, copyingEntry entry: UTMRegistryEntry?) {
+        config.information.uuid = uuid
+        if let name { config.information.name = name }
+        registryEntry = UTMRegistry.shared.entry(for: self)
+        if let entry { registryEntry.update(copying: entry) }
+    }
+
+    func updateConfigFromRegistry() {}
+
+    @MainActor func start(options: UTMVirtualMachineStartOptions) async throws {
+        guard options.isEmpty else { throw UTMNativeError.message("Disposable, recovery and remote starts are unavailable for this engine.") }
+        if state != .stopped { return }
+        guard !hasStarted, sessionPresentation == nil else {
+            throw UTMNativeError.message("This engine session has ended. Close and reopen the app before starting it again.")
+        }
+        try config.validate()
+        try UTMUnifiedEngineLease.claimNative(config)
+        state = .starting
+    }
+
+    @MainActor func stop(usingMethod method: UTMVirtualMachineStopMethod) async throws {
+        guard state != .stopped else { return }
+        state = .stopping
+        switch config.engine {
+        case .windows:
+            #if canImport(WindowsBackend)
+            UTMWindowsBackend.requestStop(force: method != .request)
+            #endif
+        case .macOS:
+            #if canImport(HengeBackend)
+            UTMHengeBackend.requestStop(force: method != .request)
+            #endif
+        }
+    }
+
+    func restart() async throws { throw UTMNativeError.message("Use Shut Down in the guest, then close and reopen the app before restarting this engine.") }
+    func pause() async throws { throw UTMNativeError.message("Pausing this ARM64 engine is not supported.") }
+    func resume() async throws { throw UTMNativeError.message("Resuming this ARM64 engine is not supported.") }
+    func reloadScreenshotFromFile() throws { screenshot = loadScreenshot() }
+
+    @MainActor func presentSession() throws {
+        if let presentation = sessionPresentation {
+            if presentation.presentingViewController == nil { Self.presenter()?.present(presentation, animated: true) }
+            return
+        }
+        let callback: (String, String?) -> Void = { [weak self] state, message in
+            Task { @MainActor in self?.engineStateChanged(state, message: message) }
+        }
+        let controller: UIViewController
+        switch config.engine {
+        case .windows:
+            #if canImport(WindowsBackend)
+            controller = UTMWindowsBackend.makeViewController(packageURL: pathUrl, configuration: config.engineConfiguration(for: pathUrl), stateChanged: callback)
+            #else
+            throw UTMNativeError.message("The Windows ARM64 backend is missing from this build.")
+            #endif
+        case .macOS:
+            #if canImport(HengeBackend)
+            controller = UTMHengeBackend.makeViewController(packageURL: pathUrl, configuration: config.engineConfiguration(for: pathUrl), stateChanged: callback)
+            #else
+            throw UTMNativeError.message("The Henge macOS backend is missing from this build.")
+            #endif
+        }
+        let presentation = UIHostingController(rootView: UTMNativeSessionView(controller: controller, status: sessionStatus) { [weak self] in
+            self?.sessionPresentation?.dismiss(animated: true)
+        })
+        presentation.modalPresentationStyle = .fullScreen
+        sessionPresentation = presentation
+        guard let presenter = Self.presenter() else {
+            sessionPresentation = nil
+            state = .stopped
+            throw UTMNativeError.message("No active app window is available for this session.")
+        }
+        presenter.present(presentation, animated: true)
+    }
+
+    @MainActor private func engineStateChanged(_ event: String, message: String?) {
+        switch event {
+        case "started": hasStarted = true; state = .started
+        case "starting": state = .starting
+        case "stopped":
+            state = .stopped
+            if let message { sessionStatus.message = message }
+        case "error":
+            state = .stopped
+            if let message {
+                sessionStatus.message = message
+                delegate?.virtualMachine(self, didErrorWithMessage: message)
+            }
+        default: break
+        }
+    }
+
+    @MainActor private static func presenter() -> UIViewController? {
+        let scenes = UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }
+        let window = scenes.first(where: { $0.activationState == .foregroundActive })?.windows.first(where: \.isKeyWindow)
+        var controller = window?.rootViewController
+        while let presented = controller?.presentedViewController { controller = presented }
+        return controller
+    }
+}
+
+private struct UTMNativeControllerView: UIViewControllerRepresentable {
+    let controller: UIViewController
+    func makeUIViewController(context: Context) -> UIViewController { controller }
+    func updateUIViewController(_ controller: UIViewController, context: Context) {}
+}
+
+private final class UTMNativeSessionStatus: ObservableObject {
+    @Published var message: String?
+}
+
+private struct UTMNativeSessionView: View {
+    let controller: UIViewController
+    @ObservedObject var status: UTMNativeSessionStatus
+    let close: () -> Void
+    var body: some View {
+        UTMNativeControllerView(controller: controller)
+            .ignoresSafeArea()
+            .overlay(alignment: .topLeading) {
+                Button(action: close) { Label("UTM Library", systemImage: "chevron.backward") }
+                    .font(.callout).padding(10)
+                    .background(.ultraThinMaterial, in: Capsule()).padding(8)
+                    .accessibilityHint("Return to the library while keeping this guest session open.")
+            }
+            .alert("Virtual Machine", isPresented: Binding(get: { status.message != nil }, set: { if !$0 { status.message = nil } })) {
+                Button("OK") { status.message = nil }
+            } message: {
+                Text(status.message ?? "")
+            }
+            .statusBarHidden(true)
+    }
+}
+#endif
