@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#if os(iOS)
+import SwiftUI
+import UniformTypeIdentifiers
+
+struct UTMNativeSettingsView: View {
+    let vm: VMData
+    @ObservedObject var config: UTMNativeConfiguration
+    @EnvironmentObject private var data: UTMData
+    @Environment(\.presentationMode) private var presentationMode
+
+    var body: some View {
+        NavigationView {
+            Form {
+                UTMNativeConfigurationFields(config: config, packageURL: vm.pathUrl, permitsMachineImport: false)
+            }
+            .navigationTitle("Settings")
+            .toolbar {
+                ToolbarItem(placement: .cancellationAction) {
+                    Button("Cancel") {
+                        presentationMode.wrappedValue.dismiss()
+                        data.busyWork { try data.discardChanges(for: vm) }
+                    }
+                }
+                ToolbarItem(placement: .confirmationAction) {
+                    Button("Save") {
+                        data.busyWorkAsync {
+                            try await data.save(vm: vm)
+                            await MainActor.run { presentationMode.wrappedValue.dismiss() }
+                        }
+                    }
+                }
+            }
+        }
+        .navigationViewStyle(.stack)
+        .disabled(data.busy)
+        .overlay(BusyOverlay())
+    }
+}
+
+struct UTMNativeCreateView: View {
+    @StateObject private var config: UTMNativeConfiguration
+    @EnvironmentObject private var data: UTMData
+
+    init(engine: UTMNativeEngine) {
+        _config = StateObject(wrappedValue: UTMNativeConfiguration(engine: engine))
+    }
+
+    private var canCreate: Bool {
+        (try? config.validate()) != nil &&
+        (config.engine == .macOS || config.mediaImportURL != nil || config.machineImportURL != nil)
+    }
+
+    var body: some View {
+        Form {
+            Section {
+                Label(config.engine.detail, systemImage: config.engine == .windows ? "pc" : "laptopcomputer")
+                Text("This engine runs ARM64 code through software translation. Hardware virtualization is not used on this iPad.")
+                    .font(.caption).foregroundStyle(.secondary)
+            }
+            UTMNativeConfigurationFields(config: config, packageURL: nil, permitsMachineImport: true)
+            Section {
+                Button("Create Virtual Machine") {
+                    data.busyWorkAsync {
+                        try config.validate()
+                        _ = try await data.create(config: config)
+                        await MainActor.run { data.showNewVMSheet = false }
+                    }
+                }
+                .disabled(!canCreate || data.busy)
+                Text(config.engine == .windows ? "Choose a licensed Windows ARM64 ISO, or copy an existing complete machine folder. Start the saved machine from the UTM library." : "Create this machine, then start it from the UTM library to download or install macOS into its guest disk.")
+                    .font(.caption).foregroundStyle(.secondary)
+            }
+        }
+        .navigationTitle(config.engine.title)
+        .disabled(data.busy)
+        .overlay(BusyOverlay())
+        .onAppear {
+            if config.information.name == config.engine.title {
+                config.information.name = data.newDefaultVMName(base: config.engine.title)
+            }
+        }
+    }
+}
+
+private struct UTMNativeConfigurationFields: View {
+    @ObservedObject var config: UTMNativeConfiguration
+    let packageURL: URL?
+    let permitsMachineImport: Bool
+    @State private var choosingMedia = false
+    @State private var choosingMachine = false
+    @State private var importError: String?
+    @State private var memoryText = "4096"
+    @State private var memoryError: String?
+
+    private var currentMedia: String {
+        if let url = config.mediaImportURL { return url.lastPathComponent }
+        if let packageURL,
+           FileManager.default.fileExists(atPath: packageURL.appendingPathComponent("Data").appendingPathComponent(config.engine.mediaName).path) {
+            return config.engine.mediaName
+        }
+        return config.engine == .windows ? "No ISO selected" : "Download in the installer"
+    }
+
+    var body: some View {
+        Section {
+            NavigationLink {
+                VMConfigInfoView(config: $config.information).navigationTitle("Information")
+            } label: {
+                Label("Information", systemImage: "info.circle").labelStyle(.roundRectIcon)
+            }
+            NavigationLink {
+                Form {
+                    LabeledContent("Engine", value: config.engine.detail)
+                    LabeledContent("Architecture", value: "ARM64")
+                    TextField("Memory (MiB)", text: memoryBinding).keyboardType(.numberPad)
+                    LabeledContent("Selected memory", value: "\(config.memoryMiB) MiB")
+                    LabeledContent("Device upper limit", value: "\(config.maximumMemoryMiB) MiB")
+                    if let memoryError { Text(memoryError).foregroundStyle(.red) }
+                    Stepper("Virtual CPUs: \(config.cpuCount)", value: $config.cpuCount, in: 1...config.engine.maximumCPUs)
+                    Text("The device limit leaves 3 GiB for iPadOS and the app, up to an engine maximum of 16 GiB. A reservation can still fail if available memory, virtual address space or guest disk storage is insufficient. Close and reopen the app before switching engine families or starting another native session.")
+                        .font(.caption).foregroundStyle(.secondary)
+                }.navigationTitle("System")
+            } label: {
+                Label("System", systemImage: "cpu").labelStyle(.roundRectIcon)
+            }
+            NavigationLink {
+                Form {
+                    Section("Installation media") {
+                        LabeledContent(config.engine == .windows ? "Windows ARM64 ISO" : "macOS restore image", value: currentMedia)
+                        Button(config.engine == .windows ? "Choose Windows ARM64 ISO…" : "Choose macOS IPSW…") { choosingMedia = true }
+                        if permitsMachineImport {
+                            Button("Import Complete Machine Folder…") { choosingMachine = true }
+                            if let folder = config.machineImportURL { Text(folder.lastPathComponent).font(.caption) }
+                        }
+                        if let importError { Text(importError).foregroundStyle(.red) }
+                    }
+                    Section("Guest disk") {
+                        if config.engine == .windows && packageURL == nil && config.machineImportURL == nil {
+                            Stepper("Disk capacity: \(config.diskSizeGiB) GiB", value: $config.diskSizeGiB, in: 64...512, step: 64)
+                        } else {
+                            Text(config.engine == .macOS ? "Henge manages the guest disk and restore state in this UTM bundle." : "The engine uses the existing Windows disk, NVRAM and TPM state together.")
+                        }
+                        Text("Import copies the complete selected machine; source files are preserved. It does not convert an arbitrary QEMU or Apple VM into this engine.")
+                            .font(.caption).foregroundStyle(.secondary)
+                    }
+                }.navigationTitle("Drives")
+            } label: {
+                Label("Drives", systemImage: "externaldrive").labelStyle(.roundRectIcon)
+            }
+            NavigationLink {
+                Form {
+                    Picker("Resolution", selection: resolutionBinding) {
+                        Text("1280 × 720").tag("1280x720")
+                        Text("1920 × 1200").tag("1920x1200")
+                        Text("2560 × 1440").tag("2560x1440")
+                        Text("2752 × 2064").tag("2752x2064")
+                    }
+                    Text(config.engine == .windows ? "Windows uses the virtual 2D display and bundled VirtIO driver. Accelerated Direct3D is unavailable in this engine." : "macOS uses Henge's paravirtual GPU with Metal command replay. Compatibility depends on the guest release and workload.")
+                        .font(.caption).foregroundStyle(.secondary)
+                }.navigationTitle("Display")
+            } label: {
+                Label("Display", systemImage: "display").labelStyle(.roundRectIcon)
+            }
+            NavigationLink {
+                Form {
+                    Toggle("Enable networking", isOn: $config.networkEnabled)
+                    Text("Uses the selected engine's user-mode network adapter. Bridged networking and arbitrary QEMU adapter settings belong to QEMU machines.")
+                        .font(.caption).foregroundStyle(.secondary)
+                }.navigationTitle("Network")
+            } label: {
+                Label("Network", systemImage: "network").labelStyle(.roundRectIcon)
+            }
+            NavigationLink {
+                Form { Toggle("Enable audio", isOn: $config.audioEnabled) }.navigationTitle("Sound")
+            } label: {
+                Label("Sound", systemImage: "speaker.wave.2").labelStyle(.roundRectIcon)
+            }
+            NavigationLink {
+                Form {
+                    Text("Hardware keyboard and pointer input is handled by the selected engine's session controls. Onscreen controls overlay the guest display.")
+                    Text("Snapshots, pause/resume, disposable sessions and changing the virtual hardware model are unavailable for these two engines. QEMU machines retain their own full UTM settings.")
+                        .font(.caption).foregroundStyle(.secondary)
+                }.navigationTitle("Input and Capabilities")
+            } label: {
+                Label("Input and Capabilities", systemImage: "keyboard").labelStyle(.roundRectIcon)
+            }
+        }
+        .onAppear { memoryText = String(config.memoryMiB) }
+        .fileImporter(isPresented: $choosingMedia, allowedContentTypes: [UTType(filenameExtension: config.engine == .windows ? "iso" : "ipsw") ?? .data]) { result in
+            do { config.mediaImportURL = try result.get(); importError = nil }
+            catch { importError = error.localizedDescription }
+        }
+        .fileImporter(isPresented: $choosingMachine, allowedContentTypes: [.folder]) { result in
+            do { config.machineImportURL = try result.get(); importError = nil }
+            catch { importError = error.localizedDescription }
+        }
+    }
+
+    private var resolutionBinding: Binding<String> {
+        Binding(get: { "\(config.displayWidth)x\(config.displayHeight)" }, set: { value in
+            let components = value.split(separator: "x").compactMap { Int($0) }
+            if components.count == 2 { config.displayWidth = components[0]; config.displayHeight = components[1] }
+        })
+    }
+
+    private var memoryBinding: Binding<String> {
+        Binding(get: { memoryText }, set: { text in
+            memoryText = text
+            if let value = Int(text.trimmingCharacters(in: .whitespacesAndNewlines)),
+               value >= 4096, value <= config.maximumMemoryMiB {
+                config.memoryMiB = value
+                memoryError = nil
+            } else {
+                config.memoryMiB = 0
+                memoryError = "Enter a whole number from 4096 to \(config.maximumMemoryMiB) MiB."
+            }
+        })
+    }
+}
