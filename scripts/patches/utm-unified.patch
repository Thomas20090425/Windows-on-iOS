diff --git a/Platform/Native/UTMNativeConfiguration.swift b/Platform/Native/UTMNativeConfiguration.swift
new file mode 100644
index 0000000..d354db4
--- /dev/null
+++ b/Platform/Native/UTMNativeConfiguration.swift
@@ -0,0 +1,224 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#if os(iOS)
+import Combine
+import Foundation
+
+enum UTMNativeEngine: String, Codable, CaseIterable, Identifiable {
+    case windows = "WindowsARM64"
+    case macOS = "macOSARM64"
+
+    var id: String { rawValue }
+    var title: String { self == .windows ? "Windows ARM64" : "macOS ARM64" }
+    var detail: String { self == .windows ? "Windows ARM64 translator" : "Henge macOS emulator" }
+    var maximumCPUs: Int { self == .windows ? 4 : 6 }
+    var mediaName: String { self == .windows ? "installer.iso" : "restore.ipsw" }
+}
+
+struct UTMNativeDrive: UTMConfigurationDrive {
+    var imageName: String?
+    var sizeMib: Int = 65536
+    var isReadOnly = false
+    var isExternal = false
+    var isRawImage: Bool { true }
+    var imageURL: URL?
+    var id = UUID().uuidString
+
+    enum CodingKeys: String, CodingKey { case imageName, sizeMib, isReadOnly, isExternal, id }
+    func clone() -> UTMNativeDrive {
+        var copy = self
+        copy.id = UUID().uuidString
+        return copy
+    }
+}
+
+final class UTMNativeConfiguration: UTMConfiguration {
+    @Published var information = UTMConfigurationInfo()
+    @Published var engine: UTMNativeEngine
+    @Published var memoryMiB = 4096
+    @Published var cpuCount = 4
+    @Published var diskSizeGiB = 64
+    @Published var networkEnabled = true
+    @Published var audioEnabled = true
+    @Published var displayWidth = 1920
+    @Published var displayHeight = 1200
+    @Published var drives: [UTMNativeDrive] = []
+    var backend: UTMBackend { .nativeARM64 }
+    var maximumMemoryMiB: Int {
+        min(16 * 1024, max(0, Int(ProcessInfo.processInfo.physicalMemory >> 20) - 3072))
+    }
+    @Published var mediaImportURL: URL?
+    @Published var machineImportURL: URL?
+
+    private enum CodingKeys: String, CodingKey {
+        case backend = "Backend", version = "ConfigurationVersion", information = "Information"
+        case engine = "Engine", memoryMiB = "MemoryMiB", cpuCount = "CPUCount", diskSizeGiB = "DiskSizeGiB"
+        case networkEnabled = "NetworkEnabled", audioEnabled = "AudioEnabled"
+        case displayWidth = "DisplayWidth", displayHeight = "DisplayHeight", drives = "Drives"
+    }
+
+    init(engine: UTMNativeEngine) {
+        self.engine = engine
+        information.name = engine.title
+        information.iconURL = UTMConfigurationInfo.builtinIcon(named: engine == .windows ? "windows" : "mac")
+    }
+
+    required init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        let version = try values.decode(Int.self, forKey: .version)
+        guard version >= Self.oldestVersion else { throw UTMConfigurationError.versionTooLow }
+        guard version <= Self.currentVersion else { throw UTMConfigurationError.versionTooHigh }
+        guard try values.decode(UTMBackend.self, forKey: .backend) == .nativeARM64 else { throw UTMConfigurationError.invalidBackend }
+        engine = try values.decode(UTMNativeEngine.self, forKey: .engine)
+        information = try values.decode(UTMConfigurationInfo.self, forKey: .information)
+        memoryMiB = try values.decode(Int.self, forKey: .memoryMiB)
+        cpuCount = try values.decode(Int.self, forKey: .cpuCount)
+        diskSizeGiB = try values.decode(Int.self, forKey: .diskSizeGiB)
+        networkEnabled = try values.decodeIfPresent(Bool.self, forKey: .networkEnabled) ?? true
+        audioEnabled = try values.decodeIfPresent(Bool.self, forKey: .audioEnabled) ?? true
+        displayWidth = try values.decodeIfPresent(Int.self, forKey: .displayWidth) ?? 1920
+        displayHeight = try values.decodeIfPresent(Int.self, forKey: .displayHeight) ?? 1200
+        drives = try values.decodeIfPresent([UTMNativeDrive].self, forKey: .drives) ?? []
+        try validate()
+    }
+
+    func encode(to encoder: Encoder) throws {
+        var values = encoder.container(keyedBy: CodingKeys.self)
+        try values.encode(backend, forKey: .backend)
+        try values.encode(Self.currentVersion, forKey: .version)
+        try values.encode(information, forKey: .information)
+        try values.encode(engine, forKey: .engine)
+        try values.encode(memoryMiB, forKey: .memoryMiB)
+        try values.encode(cpuCount, forKey: .cpuCount)
+        try values.encode(diskSizeGiB, forKey: .diskSizeGiB)
+        try values.encode(networkEnabled, forKey: .networkEnabled)
+        try values.encode(audioEnabled, forKey: .audioEnabled)
+        try values.encode(displayWidth, forKey: .displayWidth)
+        try values.encode(displayHeight, forKey: .displayHeight)
+        try values.encode(drives, forKey: .drives)
+    }
+
+    func validate() throws {
+        guard maximumMemoryMiB >= 4096, memoryMiB >= 4096, memoryMiB <= maximumMemoryMiB else {
+            throw UTMNativeError.message("Choose between 4096 and \(maximumMemoryMiB) MiB RAM for this device. The engine still needs a usable allocation at startup.")
+        }
+        guard !information.name.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+              information.name.count <= 100,
+              (1...engine.maximumCPUs).contains(cpuCount),
+              (64...512).contains(diskSizeGiB),
+              (640...4095).contains(displayWidth), (480...4095).contains(displayHeight) else {
+            throw UTMNativeError.message("Choose a name, a supported CPU count and a valid display size.")
+        }
+    }
+
+    @MainActor func prepareSave(for packageURL: URL) async throws { try validate() }
+
+    @MainActor func saveData(to dataURL: URL) async throws -> [URL] {
+        let manager = FileManager.default
+        if let source = machineImportURL {
+            let scoped = source.startAccessingSecurityScopedResource()
+            defer { if scoped { source.stopAccessingSecurityScopedResource() } }
+            try await importMachine(from: source, to: dataURL)
+            machineImportURL = nil
+        }
+        if let source = mediaImportURL {
+            let expectedExtension = engine == .windows ? "iso" : "ipsw"
+            guard source.pathExtension.lowercased() == expectedExtension else {
+                throw UTMNativeError.message("Choose a .\(expectedExtension) installation image for this engine.")
+            }
+            let scoped = source.startAccessingSecurityScopedResource()
+            defer { if scoped { source.stopAccessingSecurityScopedResource() } }
+            let destination = dataURL.appendingPathComponent(engine.mediaName)
+            if source.standardizedFileURL != destination.standardizedFileURL {
+                let staging = dataURL.appendingPathComponent(".media-\(UUID().uuidString)")
+                defer { try? manager.removeItem(at: staging) }
+                try await Task.detached { try FileManager.default.copyItem(at: source, to: staging) }.value
+                if manager.fileExists(atPath: destination.path) {
+                    _ = try manager.replaceItemAt(destination, withItemAt: staging)
+                } else {
+                    try manager.moveItem(at: staging, to: destination)
+                }
+            }
+            mediaImportURL = nil
+        }
+        _ = try await information.saveData(to: dataURL)
+        // Native engines own NVRAM, TPM, restore state and additional files here.
+        // All of them must survive the generic UTM bundle cleanup operation.
+        return try manager.contentsOfDirectory(at: dataURL, includingPropertiesForKeys: nil)
+    }
+
+    @MainActor private func importMachine(from source: URL, to dataURL: URL) async throws {
+        let manager = FileManager.default
+        let sourcePath = source.resolvingSymlinksInPath().standardizedFileURL.path
+        let destinationPath = dataURL.resolvingSymlinksInPath().standardizedFileURL.path
+        guard !destinationPath.hasPrefix(sourcePath + "/"), sourcePath != destinationPath else {
+            throw UTMNativeError.message("Choose an existing machine folder outside this new UTM bundle.")
+        }
+        if engine == .windows {
+            guard manager.fileExists(atPath: source.appendingPathComponent("vars.fd").path),
+                  manager.fileExists(atPath: source.appendingPathComponent("windows11.img").path) ||
+                  manager.fileExists(atPath: source.appendingPathComponent("windows11.hvsparse").path) else {
+                throw UTMNativeError.message("Choose the complete Windows machine folder containing its disk, vars.fd and TPM state.")
+            }
+            if manager.fileExists(atPath: source.appendingPathComponent("tpm-state-initialized").path) {
+                guard manager.fileExists(atPath: source.appendingPathComponent("TPM/identity").path),
+                      manager.fileExists(atPath: source.appendingPathComponent("TPM/permall").path) else {
+                    throw UTMNativeError.message("This Windows machine's TPM binding marker exists but its TPM identity or permanent state is missing. Import its complete backup together.")
+                }
+            }
+        } else {
+            guard manager.fileExists(atPath: source.appendingPathComponent("disk.img").path),
+                  manager.fileExists(atPath: source.appendingPathComponent("auxiliary.bin").path),
+                  manager.fileExists(atPath: source.appendingPathComponent("AVPBooter.vmapple2.bin").path),
+                  manager.fileExists(atPath: source.appendingPathComponent("machine.json").path) else {
+                throw UTMNativeError.message("Choose a complete Henge machine folder containing disk.img, auxiliary.bin, its boot ROM and machine.json identity.")
+            }
+            struct MacIdentity: Decodable { let ecid: UInt64 }
+            guard let identity = try? JSONDecoder().decode(MacIdentity.self, from: Data(contentsOf: source.appendingPathComponent("machine.json"))),
+                  identity.ecid != 0 else {
+                throw UTMNativeError.message("The Henge machine.json identity is unreadable. Its existing identity must be preserved to boot this disk.")
+            }
+        }
+        guard try manager.contentsOfDirectory(atPath: dataURL.path).isEmpty else {
+            throw UTMNativeError.message("A prepared machine can only be imported into an empty new bundle.")
+        }
+        let staging = dataURL.deletingLastPathComponent().appendingPathComponent(".native-import-\(UUID().uuidString)")
+        defer { try? manager.removeItem(at: staging) }
+        try await Task.detached {
+            guard let enumerator = FileManager.default.enumerator(at: source, includingPropertiesForKeys: [.isSymbolicLinkKey]) else {
+                throw UTMNativeError.message("The selected machine folder cannot be read.")
+            }
+            for case let item as URL in enumerator {
+                if try item.resourceValues(forKeys: [.isSymbolicLinkKey]).isSymbolicLink == true {
+                    throw UTMNativeError.message("Machine folders containing symbolic links cannot be imported.")
+                }
+            }
+            try FileManager.default.copyItem(at: source, to: staging)
+        }.value
+        if engine == .macOS {
+            try manager.moveItem(at: staging, to: dataURL.appendingPathComponent("Henge"))
+        } else {
+            try manager.removeItem(at: dataURL) // Empty directory belonging to the new bundle.
+            try manager.moveItem(at: staging, to: dataURL)
+        }
+    }
+
+    func engineConfiguration(for packageURL: URL) -> NSDictionary {
+        let media = packageURL.appendingPathComponent("Data").appendingPathComponent(engine.mediaName)
+        var values: [String: Any] = [
+            "name": information.name, "uuid": information.uuid.uuidString,
+            "backend": engine.rawValue, "memoryMiB": memoryMiB, "cpuCount": cpuCount,
+            "diskSizeGiB": diskSizeGiB, "networkEnabled": networkEnabled,
+            "audioEnabled": audioEnabled, "displayWidth": displayWidth, "displayHeight": displayHeight
+        ]
+        if FileManager.default.fileExists(atPath: media.path) { values["installationMediaPath"] = media.path }
+        return values as NSDictionary
+    }
+}
+
+enum UTMNativeError: LocalizedError {
+    case message(String)
+    var errorDescription: String? {
+        switch self { case .message(let message): return message }
+    }
+}
+#endif
