+/* Physical page identities make mappings of one surface in different guest
+   processes share the same host pixels. A virtual mapping address does not. */
+static NSData *linear_storage_key(HvReplay *r, HvObject *owner, id<MTLBuffer> buffer,
+                                  NSUInteger offset, NSUInteger row, NSUInteger width, NSUInteger height) {
+    uint64_t layout[5] = {row, width, height, offset & 0x3fff, owner->mapped && owner->pages ? 1 : 2};
+    NSMutableData *key = [NSMutableData dataWithBytes:layout length:sizeof layout];
+    if (owner->mapped && owner->pages) {
+        NSUInteger last = offset + (height - 1) * row + width - 1;
+        for (NSUInteger p = offset >> 14; p <= last >> 14; p++) {
+            uint32_t page = owner->pages[p];
+            uint8_t *address = owner->vpage ? (page ? hv_pvg_lite_page(r->lite, page) : NULL) :
+                ((page & 1) ? hv_pvg_lite_phys(r->lite, (uint64_t)(page & ~1u) << 12, 0x4000) : NULL);
+            uintptr_t identity = address ? (uintptr_t)address : (uintptr_t)owner->mapped + (p << 14);
+            [key appendBytes:&identity length:sizeof identity];
+        }
+    } else {
+        uintptr_t identity = (uintptr_t)(__bridge void *)((id)buffer.heap ?: (id)buffer);
+        uint64_t position = offset + (buffer.heap ? buffer.heapOffset : 0);
+        [key appendBytes:&identity length:sizeof identity];
+        [key appendBytes:&position length:sizeof position];
+    }
+    return key;
+}
