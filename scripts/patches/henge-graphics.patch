+/* BEGIN LINEAR BACKING: also compiled by the focused Metal round-trip harness. */
+@interface HvLinearBacking : NSObject {
+@public
+    id<MTLBuffer> buffer;
+    NSUInteger row, width_bytes, height;
+}
+@end
+@implementation HvLinearBacking
+@end
+
+static HvLinearBacking *make_linear_backing(id<MTLDevice> device, NSUInteger bytes, NSUInteger height) {
+    if (!bytes || !height || bytes > NSUIntegerMax - 4095) return nil;
+    NSUInteger row = (bytes + 4095) & ~(NSUInteger)4095;
+    if (height > device.maxBufferLength / row) return nil;
+    HvLinearBacking *backing = [HvLinearBacking new];
+    backing->buffer = [device newBufferWithLength:row * height options:MTLResourceStorageModeShared];
+    if (!backing->buffer) return nil;
+    backing->row = row, backing->width_bytes = bytes, backing->height = height;
+    return backing;
+}
+
+/* Buffer copies have no linear-texture row alignment requirement. Byte-sized
+   layouts use a compute copy when Metal's buffer blit alignment does not fit. */
+static BOOL copy_linear_rows(id<MTLDevice> device, id<MTLCommandBuffer> cb,
+                             id<MTLBlitCommandEncoder> *blit, id<MTLBuffer> from, NSUInteger offset, NSUInteger row,
+                             HvLinearBacking *backing, BOOL to_guest) {
+    if (!from || !backing || offset > from.length || !row || backing->width_bytes > row ||
+        backing->width_bytes > from.length - offset ||
+        backing->height - 1 > (from.length - offset - backing->width_bytes) / row) return NO;
+    id<MTLBuffer> src = to_guest ? backing->buffer : from, dst = to_guest ? from : backing->buffer;
+    NSUInteger src_offset = to_guest ? 0 : offset, dst_offset = to_guest ? offset : 0;
+    NSUInteger src_row = to_guest ? backing->row : row, dst_row = to_guest ? row : backing->row;
+    BOOL word_aligned = !((src_offset | dst_offset | src_row | dst_row | backing->width_bytes) & 3);
+    if (word_aligned && (backing->height <= 64 || (src_row == dst_row && src_row == backing->width_bytes))) {
+        if (!*blit) *blit = [cb blitCommandEncoder];
+        if (src_row == dst_row && src_row == backing->width_bytes) {
+            [*blit copyFromBuffer:src sourceOffset:src_offset toBuffer:dst destinationOffset:dst_offset size:src_row * backing->height];
+            return YES;
+        }
+        for (NSUInteger y = 0; y < backing->height; y++)
+            [*blit copyFromBuffer:src sourceOffset:src_offset + y * src_row
+                        toBuffer:dst destinationOffset:dst_offset + y * dst_row size:backing->width_bytes];
+        return YES;
+    }
+    [*blit endEncoding];
+    *blit = nil;
+    static id<MTLDevice> pipeline_device;
+    static id<MTLComputePipelineState> pipeline;
+    id<MTLComputePipelineState> state;
+    @synchronized ([HvLinearBacking class]) {
+        if (pipeline_device != device) {
+            NSError *error = nil;
+            NSString *source = @"#include <metal_stdlib>\nusing namespace metal;\n"
+                "kernel void copy_rows(device const uchar *s [[buffer(0)]], device uchar *d [[buffer(1)]], "
+                "constant ulong *p [[buffer(2)]], uint2 q [[thread_position_in_grid]]) { "
+                "ulong x=ulong(q.x)*16; if (x >= p[4] || q.y >= p[5]) return; "
+                "device const uchar *sr=s+p[0]+q.y*p[1]; device uchar *dr=d+p[2]+q.y*p[3]; "
+                "if (((p[0]|p[1]|p[2]|p[3]|p[4]) & 15)==0) "
+                "((device uint4 *)dr)[q.x]=((device const uint4 *)sr)[q.x]; "
+                "else for (uint i=0;i<16 && x+i<p[4];i++) dr[x+i]=sr[x+i]; }";
+            id<MTLLibrary> library = [device newLibraryWithSource:source options:nil error:&error];
+            pipeline = library ? [device newComputePipelineStateWithFunction:[library newFunctionWithName:@"copy_rows"] error:&error] : nil;
+            if (!pipeline) { fprintf(stderr, "hengevm: pvg-metal: linear row copy pipeline: %s\n", error.localizedDescription.UTF8String); return NO; }
+            pipeline_device = device;
+        }
+        state = pipeline;
+    }
+    uint64_t layout[6] = {src_offset, src_row, dst_offset, dst_row, backing->width_bytes, backing->height};
+    id<MTLComputeCommandEncoder> encoder = [cb computeCommandEncoder];
+    [encoder setComputePipelineState:state];
+    [encoder setBuffer:src offset:0 atIndex:0];
+    [encoder setBuffer:dst offset:0 atIndex:1];
+    [encoder setBytes:layout length:sizeof layout atIndex:2];
+    [encoder dispatchThreads:MTLSizeMake((backing->width_bytes + 15) / 16, backing->height, 1)
+      threadsPerThreadgroup:MTLSizeMake(MIN((NSUInteger)256, state.maxTotalThreadsPerThreadgroup), 1, 1)];
+    [encoder endEncoding];
+    return YES;
+}
