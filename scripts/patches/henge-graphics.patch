+- (void)bufferTexture:(HvObject *)o owner:(HvObject *)owner buffer:(id<MTLBuffer>)buffer
+           descriptor:(MTLTextureDescriptor *)t offset:(NSUInteger)offset row:(NSUInteger)row {
+    NSUInteger bpp = pixel_bytes(t.pixelFormat);
+    BOOL simple = t.textureType == MTLTextureType2D && t.depth == 1 && t.arrayLength == 1 &&
+        t.mipmapLevelCount == 1 && t.sampleCount == 1 && bpp;
+    BOOL bounds = simple && t.width <= NSUIntegerMax / bpp && offset <= buffer.length && row && t.height &&
+        t.width * bpp <= row && t.width * bpp <= buffer.length - offset &&
+        t.height - 1 <= (buffer.length - offset - t.width * bpp) / row;
+    if (!bounds) {
+        if (linear_texture_fits(device, t, offset, row, buffer.length))
+            o->object = [buffer newTextureWithDescriptor:t offset:offset bytesPerRow:row];
+        return;
+    }
+    o->linear_guest = buffer;
+    o->linear_offset = offset, o->linear_row = row;
+    o->linear_key = linear_storage_key(self, owner, buffer, offset, row, t.width * bpp, t.height);
+    if (!linear_backings) linear_backings = [NSMapTable strongToWeakObjectsMapTable];
+    HvLinearBacking *backing = [linear_backings objectForKey:o->linear_key];
+    if (!backing) {
+        backing = make_linear_backing(device, t.width * bpp, t.height);
+        if (!backing) return;
+        [linear_backings setObject:backing forKey:o->linear_key];
+    }
+    /* Use canonical storage from the first view, even when that particular
+       format could use the guest row directly. The guest can cache Metal
+       resource IDs, so a later alias must not replace an already exposed texture. */
+    MTLTextureDescriptor *description = [t copy];
+    description.resourceOptions = backing->buffer.resourceOptions;
+    o->object = [backing->buffer newTextureWithDescriptor:description offset:0 bytesPerRow:backing->row];
+    o->linear = backing;
+}
