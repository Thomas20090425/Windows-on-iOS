+        case .idle: break
+        case .checking: phase = "checking"
+        case .downloading: phase = "downloading"
+        case .preparing: phase = "preparing"
+        case .installing: phase = "installing"
+        case .done(let text): phase = "done"; message = text
+        case .failed(let text): phase = "failed"; message = text
+        }
+        let state: [String: Any] = [
+            "timestamp": ISO8601DateFormatter().string(from: Date()),
+            "bundle_id": Bundle.main.bundleIdentifier ?? "unknown",
+            "jit_ready": JITBootstrap.ready, "installer_phase": phase,
+            "installer_message": message, "received_bytes": installer.received,
+            "expected_bytes": installer.expected, "restore_step": installer.step,
+            "restore_progress": installer.stepProgress, "vm_state": henge_vm_state(),
+            "vm_exit_reason": String(cString: henge_vm_exit_reason()),
+            "machines": Machines.shared.all.map { ["name": $0.name, "id": $0.id.uuidString, "ram_mb": $0.ramMB] as [String: Any] }
+        ]
+        if let data = try? JSONSerialization.data(withJSONObject: state, options: [.prettyPrinted, .sortedKeys]) {
+            try? data.write(to: docs.appendingPathComponent("henge-research-status.json"), options: .atomic)
+        }
+    }
+
+    @MainActor private static func perform(_ line: String, start: (VirtualMac) -> Void, showInstaller: () -> Void) async {
         let parts = line.split(separator: " ", maxSplits: 1).map(String.init)
