         switch parts[0] {
+        case "install": // install BUILD RAM_MIB NAME; a NEW virtual Mac only, never the physical iPad.
+            let fields = arg.split(separator: " ", maxSplits: 2).map(String.init)
+            guard fields.count == 3,
+                  let release = MacOSRelease.all.first(where: { $0.id == fields[0] }),
+                  let ram = Int(fields[1]), [4096, 6144, 8192].contains(ram),
+                  !fields[2].isEmpty else {
+                HengeLog.log("autopilot", "install wants a known build, 4096/6144/8192 MiB and a name")
+                return
+            }
+            guard !Installer.shared.busy else { return }
+            for _ in 0..<240 where !JITBootstrap.ready {
+                writeStatus()
+                try? await Task.sleep(nanoseconds: 500_000_000)
+            }
+            guard JITBootstrap.ready else { HengeLog.log("autopilot", "JIT is not ready; not restoring"); return }
+            guard !Machines.shared.all.contains(where: { $0.name == fields[2] }) else {
+                HengeLog.log("autopilot", "a Mac with that name already exists; not restoring again")
+                return
+            }
+            showInstaller()
+            Installer.shared.start(release, name: fields[2], ramMB: ram, cpus: 4, keepImage: true)
         case "mac":
             for _ in 0..<240 where !JITBootstrap.ready { try? await Task.sleep(nanoseconds: 500_000_000) }
             guard JITBootstrap.ready else { HengeLog.log("autopilot", "JIT is not on; not starting a Mac"); return }
